{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "last_train",
  "compatibility_date": "2026-09-13",
  "main": "src/index.js",
  // Stamps public/shared/version.js from the sources before every deploy and dev run,
  // so a page left open across a deploy can tell the server moved on.
  "build": { "command": "node tools/stamp.mjs" },
  "observability": {
    "enabled": true
  },
  // Attached to the shared hostname by path-scoped Routes, NOT a Custom Domain
  // — the `games` hub Worker holds that. Cloudflare matches the most-specific
  // route first, so these peel /last_train off the hub.
  // Two patterns: `/*` does not match the bare prefix, and the bare prefix is
  // what src/index.js redirects to the trailing-slash form.
  "routes": [
    { "pattern": "games.csiesheep.com/last_train", "zone_name": "csiesheep.com" },
    { "pattern": "games.csiesheep.com/last_train/*", "zone_name": "csiesheep.com" }
  ],
  // Only public/ is uploaded as static assets; src/ is bundled into the Worker.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // One Durable Object per multiplayer room, named by its four-letter code.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
